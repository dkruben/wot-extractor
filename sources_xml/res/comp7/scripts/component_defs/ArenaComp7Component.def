<!-- Copia descodificada (XML binario BigWorld) gerada pelo wot-extractor. Original: sources/res/comp7/scripts/component_defs/ArenaComp7Component.def -->
<root>
	<BaseMethods>
		<messenger_onActionByClient_chat2>
			<Arg>MAILBOX</Arg>
			<Arg>DB_ID</Arg>
			<Arg>INT16</Arg>
			<Arg>INT32</Arg>
			<Arg>GENERIC_MESSENGER_ARGS_chat2</Arg>
		</messenger_onActionByClient_chat2>
		<messenger_onActionByServer_chat2>
			<Arg>MAILBOX</Arg>
			<Arg>INT16</Arg>
			<Arg>INT32</Arg>
			<Arg>GENERIC_MESSENGER_ARGS_chat2</Arg>
		</messenger_onActionByServer_chat2>
		<updateVehicleBanList>
			<Arg>PYTHON</Arg>
		</updateVehicleBanList>
		<updateTeamsDamageDealt>
			<Arg>ARRAY<of>INT32</of>
				<size>2</size>
			</Arg>
		</updateTeamsDamageDealt>
	</BaseMethods>
	<CellMethods>
		<setupArena />
	</CellMethods>
	<ofEntity>
		<Arena />
	</ofEntity>
</root>
