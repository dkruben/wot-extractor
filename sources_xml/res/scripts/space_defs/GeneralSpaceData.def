<!-- Copia descodificada (XML binario BigWorld) gerada pelo wot-extractor. Original: sources/res/scripts/space_defs/GeneralSpaceData.def -->
<root>
	<Implements>
		<Interface>SpaceRecording</Interface>
	</Implements>
	<Persistent>true</Persistent>
	<LoDLevels>
		<manual>
			<label>MY_VEHICLE</label>
		</manual>
		<manual>
			<label>GUN_MARKER</label>
		</manual>
		<manual>
			<label>MY_TEAM</label>
		</manual>
	</LoDLevels>
	<Properties>
		<isRecording>
			<Type>STRING</Type>
		</isRecording>
		<itemsVisibilityMask>
			<Type>UINT32</Type>
			<Exposed />
			<ExposedForReplay>true</ExposedForReplay>
		</itemsVisibilityMask>
		<environment>
			<Type>STRING</Type>
			<Exposed />
			<ExposedForReplay>true</ExposedForReplay>
		</environment>
		<replicableHash>
			<Type>UINT64</Type>
			<Exposed />
			<ExposedForReplay>true</ExposedForReplay>
			<Default>0</Default>
		</replicableHash>
	</Properties>
</root>
