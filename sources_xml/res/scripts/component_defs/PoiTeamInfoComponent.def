<!-- Copia descodificada (XML binario BigWorld) gerada pelo wot-extractor. Original: sources/res/scripts/component_defs/PoiTeamInfoComponent.def -->
<root>
	<Properties>
		<capturedPoints>
			<Type>PYTHON</Type>
			<Flags>ALL_CLIENTS</Flags>
			<AllowUnsafeData>true</AllowUnsafeData>
		</capturedPoints>
	</Properties>
	<ClientMethods>
		<onPoiEquipmentUsed>
			<Arg>INT32</Arg>
			<Arg>UINT16</Arg>
		</onPoiEquipmentUsed>
		<onPoiCaptured>
			<Arg>INT32</Arg>
			<Arg>INT32</Arg>
		</onPoiCaptured>
		<onPoiInvaderDestroyed>
			<Arg>INT32</Arg>
		</onPoiInvaderDestroyed>
	</ClientMethods>
	<ofEntity>
		<TeamInfo />
	</ofEntity>
	<DefaultKeyName>PoiTeamInfoComponent</DefaultKeyName>
</root>
